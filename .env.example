# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Encryption (Generate a strong 32-character random string)
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Session Storage Path (Local filesystem path for WhatsApp sessions)
SESSION_DATA_PATH=./session-data

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: Supabase Storage Bucket Name
SUPABASE_MEDIA_BUCKET=whatsapp-media
